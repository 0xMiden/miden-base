# Moving a whole account balance into an output note.
#
# See the `PassThroughSweep` Rust type's documentation for more details.

use miden::core::word
use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::output_note
use {AssetId} from miden::protocol::types

# PUBLIC INTERFACE
# =================================================================================================

#! Moves the account's entire balance of the given asset into the output note at `note_idx`.
#!
#! No-op if the account holds none of the asset.
#!
#! By itself, this procedure does not restrict who can invoke it. What bounds it is the account it
#! is installed on. For authenticated usage, pair with auth::pass_through so that only the holder
#! of the pubkey stored in the account can execute a transaction against it.
#!
#! That bounds who may start a transaction, not who may call this procedure: a note script the
#! transaction consumes can call it too, and redirect what earlier notes deposited.
#!
#! Inputs:  [ASSET_ID, note_idx, pad(11)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ASSET_ID is the ID of the asset to move.
#! - note_idx is the index of the output note to move the balance into.
#!
#! Panics if:
#! - the maximum number of assets per note is exceeded.
#!
#! Invocation: call
@account_procedure
pub proc sweep_asset_to_note(asset_id: AssetId, note_idx: u16)
    dupw exec.active_account::get_asset
    # => [ASSET_VALUE, ASSET_ID, note_idx, pad(11)]

    dupw exec.word::eqz
    # => [is_absent, ASSET_VALUE, ASSET_ID, note_idx, pad(11)]

    if.true
        # the account holds none of the asset, so there is nothing to move
        dropw dropw drop
        # => [pad(16)]
    else
        swapw
        # => [ASSET_ID, ASSET_VALUE, note_idx, pad(11)]

        # remove the balance from the vault and add it to the note
        dupw.1 dupw.1
        # => [ASSET_ID, ASSET_VALUE, ASSET_ID, ASSET_VALUE, note_idx, pad(11)]

        exec.native_account::remove_asset dropw
        # => [ASSET_ID, ASSET_VALUE, note_idx, pad(11)]

        exec.output_note::add_asset
        # => [pad(16)]
    end
end
