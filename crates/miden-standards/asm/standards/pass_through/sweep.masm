# Moving a whole account balance into an output note.
#
# See the `PassThroughSweep` Rust type's documentation for more details.

use miden::core::word
use miden::protocol::active_account
use miden::protocol::native_account
use miden::protocol::output_note
use {AssetId} from miden::protocol::types

# PUBLIC INTERFACE
# =================================================================================================

#! Moves the account's entire balance of the given asset into the output note at `note_idx`.
#!
#! Moving the whole balance is what makes a pass-through transaction independent of how many notes
#! it consumes: whatever the input notes deposited is a single balance by the time this runs, so
#! one call per asset drains it regardless of the number of notes.
#!
#! No-op if the account holds none of the asset.
#!
#! Unlike wallets::basic::move_asset_to_note, which takes the amount to move, this procedure reads
#! the balance itself, so it needs no prior knowledge of what the vault holds. It moves the entire
#! balance and bounds nobody who calls it: any note script the account consumes can call it and
#! redirect what earlier notes deposited.
#!
#! What bounds it is the account it is installed on. Paired with auth::pass_through, only the
#! holder of the account's key can execute a transaction against it, and the summary they sign
#! binds both the notes consumed and the notes created, so every destination the assets reach is
#! covered by that signature - which makes it a matter of not signing for notes whose scripts have
#! not been vetted, rather than of who may transact. Installed alongside an auth procedure that authenticates nobody, the
#! same procedure lets any third party execute a transaction as the account and pick the
#! destination themselves. The pairing is therefore part of this component's contract, not a
#! recommendation - and this procedure cannot check it, since an account procedure has no way to
#! ask which auth procedure the account installs.
#!
#! Inputs:  [ASSET_ID, note_idx, pad(11)]
#! Outputs: [pad(16)]
#!
#! Where:
#! - ASSET_ID is the ID of the asset to move.
#! - note_idx is the index of the output note to move the balance into.
#!
#! Panics if:
#! - the maximum number of assets per note is exceeded.
#!
#! Invocation: call
@account_procedure
pub proc sweep_asset_to_note(asset_id: AssetId, note_idx: u16)
    dupw exec.active_account::get_asset
    # => [ASSET_VALUE, ASSET_ID, note_idx, pad(11)]

    dupw exec.word::eqz
    # => [is_absent, ASSET_VALUE, ASSET_ID, note_idx, pad(11)]

    if.true
        # the account holds none of the asset, so there is nothing to move
        dropw dropw drop
        # => [pad(16)]
    else
        swapw
        # => [ASSET_ID, ASSET_VALUE, note_idx, pad(11)]

        # remove the balance from the vault and add it to the note
        dupw.1 dupw.1
        # => [ASSET_ID, ASSET_VALUE, ASSET_ID, ASSET_VALUE, note_idx, pad(11)]

        exec.native_account::remove_asset dropw
        # => [ASSET_ID, ASSET_VALUE, note_idx, pad(11)]

        exec.output_note::add_asset
        # => [pad(16)]
    end
end
